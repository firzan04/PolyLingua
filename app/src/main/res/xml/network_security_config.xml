<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted so a self-hosted signaling relay on a LAN / hotspot address
     (ws://192.168.x.x:8080) works. All public endpoints (GitHub, Hugging Face) use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
